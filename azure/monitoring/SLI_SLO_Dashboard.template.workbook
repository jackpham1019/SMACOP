    {
      "type": 3,
      "name": "logs query - 1",
      "content": {
        "version": "KqlItem/1.0",
        "title": "SLI vs SLO ({BaselineTrafficTimeRange})",
        "query": "let JourneySLOs =\n    union\n    (\n        print\n            Journey = \"user-login\",\n            AvailabilitySLO =\n                todouble('{user_login_avail_slo}') / 100.0,\n            LatencySLOMs =\n                todouble('{user_login_latency_slo}')\n    ),\n    (\n        print\n            Journey = \"user-register\",\n            AvailabilitySLO =\n                todouble('{user_register_avail_slo}') / 100.0,\n            LatencySLOMs =\n                todouble('{user_register_latency_slo}')\n    ),\n    (\n        print\n            Journey = \"check-balance\",\n            AvailabilitySLO =\n                todouble('{check_balance_avail_slo}') / 100.0,\n            LatencySLOMs =\n                todouble('{check_balance_latency_slo}')\n    );\n\n// Calculate the exact lengths of the traffic windows.\n// The minimum protects against a custom zero-length range.\nlet BaselineWindowHours =\n    max_of(\n        1.0 / 3600.0,\n        todouble(\n            datetime_diff(\n                \"second\",\n                todatetime('{BaselineTrafficTimeRange:end}'),\n                todatetime('{BaselineTrafficTimeRange:start}')\n            )\n        ) / 3600.0\n    );\n\nlet CurrentWindowHours =\n    max_of(\n        1.0 / 3600.0,\n        todouble(\n            datetime_diff(\n                \"second\",\n                todatetime('{CurrentTrafficTimeRange:end}'),\n                todatetime('{CurrentTrafficTimeRange:start}')\n            )\n        ) / 3600.0\n    );\n\n// SLO metrics for the selected evaluation period.\nlet RequestMetrics =\n    AppRequests\n    | where TimeGenerated {TimeRange}\n    | extend Journey = tostring(Properties[\"app.journey\"])\n    | where isnotempty(Journey)\n    | summarize\n        Volume = sum(ItemCount),\n        SuccessfulRequests = sumif(ItemCount, Success == true),\n        P95LatencyMs = percentilew(DurationMs, ItemCount, 95)\n      by Journey\n    | extend\n        Availability =\n            todouble(SuccessfulRequests) / todouble(Volume);\n\n// Historical average hourly traffic over the baseline window.\nlet BaselineTraffic =\n    AppRequests\n    | where TimeGenerated {BaselineTrafficTimeRange}\n    | extend Journey = tostring(Properties[\"app.journey\"])\n    | where isnotempty(Journey)\n    | summarize\n        BaselineVolume = sum(ItemCount)\n      by Journey\n    | extend\n        BaselineRequestsPerHour =\n            todouble(BaselineVolume) / BaselineWindowHours;\n\n// Recent hourly traffic over the current traffic window.\nlet CurrentTraffic =\n    AppRequests\n    | where TimeGenerated {CurrentTrafficTimeRange}\n    | extend Journey = tostring(Properties[\"app.journey\"])\n    | where isnotempty(Journey)\n    | summarize\n        CurrentTrafficVolume = sum(ItemCount)\n      by Journey\n    | extend\n        CurrentRequestsPerHour =\n            todouble(CurrentTrafficVolume) / CurrentWindowHours;\n\nJourneySLOs\n| join kind=leftouter RequestMetrics on Journey\n| join kind=leftouter BaselineTraffic on Journey\n| join kind=leftouter CurrentTraffic on Journey\n\n| extend\n    Volume = coalesce(Volume, 0),\n    BaselineVolume = coalesce(BaselineVolume, 0),\n    CurrentTrafficVolume = coalesce(CurrentTrafficVolume, 0),\n    BaselineRequestsPerHour =\n        coalesce(BaselineRequestsPerHour, 0.0),\n    CurrentRequestsPerHour =\n        coalesce(CurrentRequestsPerHour, 0.0),\n    Availability = iff(\n        Volume == 0,\n        real(null),\n        Availability\n    )\n\n// Availability/error-budget calculation.\n| extend\n    AllowedFailureRate = 1.0 - AvailabilitySLO,\n    ActualFailureRate = iff(\n        Volume == 0,\n        real(null),\n        1.0 - Availability\n    )\n\n// Burn rate:\n// 1.0 = consuming the entire allowed budget at the permitted rate.\n// <1.0 = within the budget.\n// >1.0 = exceeding the allowed failure rate.\n| extend\n    BurnRate = case(\n        Volume == 0,\n        real(null),\n\n        AllowedFailureRate == 0.0\n            and ActualFailureRate <= 0.0,\n        0.0,\n\n        AllowedFailureRate == 0.0,\n        real(null),\n\n        ActualFailureRate / AllowedFailureRate\n    )\n\n// Error-budget remaining:\n// 1.0 = 100% remains.\n// 0.0 = fully consumed.\n// Negative = exceeded.\n| extend\n    AvailabilityBudgetRemaining = case(\n        isnull(BurnRate),\n        real(null),\n\n        1.0 - BurnRate\n    )\n\n// Latency headroom in percentage.\n// Positive = below limit.\n// Zero = exactly at limit.\n// Negative = above limit.\n| extend\n    LatencyHeadroomRatio = case(\n        Volume == 0\n            or isnull(P95LatencyMs),\n        real(null),\n\n        LatencySLOMs <= 0.0,\n        real(null),\n\n        (LatencySLOMs - P95LatencyMs)\n            / LatencySLOMs\n    )\n\n\n// Current traffic relative to the historical baseline.\n// 1.20 means current traffic is 20% above baseline.\n| extend\n    TrafficRatio = case(\n        BaselineRequestsPerHour <= 0.0,\n        real(null),\n\n        CurrentRequestsPerHour / BaselineRequestsPerHour\n    )\n\n| extend\n    TrafficChange = case(\n        isnull(TrafficRatio),\n        real(null),\n\n        TrafficRatio - 1.0\n    )\n\n// 2 = healthy, 1 = warning, 0 = breached, -1 = no data.\n| extend\n    AvailabilityStatus = case(\n        Volume == 0, -1,\n        BurnRate > 1.0, 0,\n        BurnRate >= 0.50, 1,\n        2\n    )\n\n| extend\n    LatencyStatus = case(\n        Volume == 0 or isnull(P95LatencyMs), -1,\n        LatencyHeadroomRatio < 0.0, 0,\n        LatencyHeadroomRatio <= 0.20, 1,\n        2\n    )\n\n| project\n    Journey,\n\n    Availability = round(Availability, 2),\n    ['Error Budget Remaining (%)'] =\n        round(AvailabilityBudgetRemaining, 2),\n\n    ['P95 Latency (ms)'] =\n        round(P95LatencyMs, 0),\n    ['Latency Headroom (ms)'] =\n        round(LatencyHeadroomRatio, 1),\n\n    ['SLO Window Volume'] =\n        Volume,\n    ['Current Requests/hr'] =\n        round(CurrentRequestsPerHour, 1),\n    ['Baseline Requests/hr'] =\n        round(BaselineRequestsPerHour, 1),\n    ['Traffic Change (%)'] =\n        round(TrafficChange, 2),\n\n    Correctness = \"N/A\",\n    AvailabilityStatus,\n    LatencyStatus\n\n| order by Journey asc",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "__LOG_ANALYTICS_WORKSPACE_RESOURCE_ID__"
        ],
        "timeContext": {
          "durationMs": 86400000
        },
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Availability$",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "sourceColumn": "AvailabilityStatus",
                    "thresholdValue": "1",
                    "representation": "dot-green"
                  },
                  {
                    "operator": ">",
                    "sourceColumn": "AvailabilityStatus",
                    "thresholdValue": "0",
                    "representation": "dot-yellow"
                  },
                  {
                    "operator": ">",
                    "sourceColumn": "AvailabilityStatus",
                    "thresholdValue": "-1",
                    "representation": "dot-redBright"
                  },
                  {
                    "operator": "Default",
                    "representation": ""
                  }
                ]
              },
              "numberFormat": {
                "unit": 0,
                "options": {
                  "style": "percent",
                  "useGrouping": false,
                  "minimumIntegerDigits": 1,
                  "minimumFractionDigits": 0
                }
              }
            },
            {
              "columnMatch": "P95 Latency",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "sourceColumn": "LatencyStatus",
                    "thresholdValue": "1",
                    "representation": "dot-green"
                  },
                  {
                    "operator": ">",
                    "sourceColumn": "LatencyStatus",
                    "thresholdValue": "0",
                    "representation": "dot-yellow"
                  },
                  {
                    "operator": ">",
                    "sourceColumn": "LatencyStatus",
                    "thresholdValue": "-1",
                    "representation": "dot-redBright"
                  },
                  {
                    "operator": "Default",
                    "representation": ""
                  }
                ]
              }
            },
            {
              "columnMatch": "AvailabilityStatus",
              "formatter": 0,
              "formatOptions": {}
            },
            {
              "columnMatch": "Journey",
              "formatter": 1,
              "formatOptions": {
                "linkTarget": "OpenBlade",
                "linkIsContextBlade": false,
                "bladeOpenContext": {
