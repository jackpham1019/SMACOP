    {
      "type": 3,
      "name": "5xx Error Rate by Service",
      "content": {
        "version": "KqlItem/1.0",
        "title": "5xx Error Rate by Service ({TimeRange})",
        "query": "AppRequests\n| where TimeGenerated {TimeRange}\n| extend\n    Service = iff(\n        isnotempty(AppRoleName),\n        AppRoleName,\n        \"unknown\"\n    )\n| summarize\n    Total = sum(ItemCount),\n    Errors = sumif(\n        ItemCount,\n        tostring(ResultCode) startswith \"5\"\n    )\n    by\n        bin(TimeGenerated, 5m),\n        Service\n| extend\n    ErrorRate = 100.0 * todouble(Errors) / Total\n| project\n    TimeGenerated,\n    Service,\n    ErrorRate\n| order by TimeGenerated asc",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
