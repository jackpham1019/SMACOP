    {
      "type": 3,
      "name": "Service Health {TimeRange}",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Service Health ({TimeRange})",
        "query": "let Requests =\n    AppRequests\n    | where TimeGenerated {TimeRange}\n    | extend Service = case(\n        isnotempty(AppRoleName), AppRoleName,\n        isnotempty(AppRoleInstance), AppRoleInstance,\n        \"unknown-service\"\n    );\n\nlet Window =\n    Requests\n    | summarize\n        WindowStart = min(TimeGenerated),\n        WindowEnd = max(TimeGenerated)\n    | extend WindowMinutes =\n        max_of(datetime_diff(\"second\", WindowEnd, WindowStart) / 60.0, 1.0);\n\nRequests\n| summarize\n    RequestCount = sum(ItemCount),\n    Errors5xx = sumif(\n        ItemCount,\n        tostring(ResultCode) startswith \"5\"\n    ),\n    Errors4xx = sumif(\n        ItemCount,\n        tostring(ResultCode) startswith \"4\"\n    ),\n    P95LatencyMs = percentilew(\n        DurationMs,\n        ItemCount,\n        95\n    )\n    by Service\n| extend JoinKey = 1\n| join kind=inner (\n    Window\n    | extend JoinKey = 1\n) on JoinKey\n| extend\n    ReqPerMin = round(\n        todouble(RequestCount) / WindowMinutes,\n        2\n    ),\n    Rate5xx = round(\n        100.0 * todouble(Errors5xx)\n        / max_of(todouble(RequestCount), 1.0),\n        2\n    ),\n    Rate4xx = round(\n        100.0 * todouble(Errors4xx)\n        / max_of(todouble(RequestCount), 1.0),\n        2\n    )\n| project\n    Service,\n    ReqPerMin,\n    Rate5xx,\n    Rate4xx,\n    P95LatencyMs\n| order by Service asc",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "__LOG_ANALYTICS_WORKSPACE_RESOURCE_ID__"
        ],
        "timeContextFromParameter": "TimeRange",
        "visualization": "table",
        "gridSettings": {
          "labelSettings": [
            {
              "columnId": "Column1",
              "label": "Req/Min"
            },
            {
              "columnId": "Column2",
              "label": "5xx Rate"
            },
            {
              "columnId": "Column3",
              "label": "4xx Rate"
            },
            {
              "columnId": "Column4",
              "label": "P95 Latency (ms)"
            }
          ]
        }
      },
      "styleSettings": {
        "showBorder": true,
        "borderStyle": "light thick",
        "w": 24,
        "h": 5,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": 3,
      "name": "Requests Rate By Service",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Requests Rate By Service ({TimeRange})",
        "query": "AppRequests\n| where TimeGenerated {TimeRange}\n| extend\n    Service = iff(\n        isnotempty(AppRoleName),\n        AppRoleName,\n        \"unknown\"\n    )\n| summarize\n    Requests = sum(ItemCount)\n    by\n        bin(TimeGenerated, 5m),\n        Service\n| extend\n    ReqPerMin = Requests / 5.0\n| project\n    TimeGenerated,\n    Service,\n    ReqPerMin\n| order by TimeGenerated asc",
        "size": 0,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "__LOG_ANALYTICS_WORKSPACE_RESOURCE_ID__"
        ],
        "timeContextFromParameter": "TimeRange",
        "visualization": "linechart",
        "aggregation": 3
      },
      "styleSettings": {
        "showBorder": true,
        "borderStyle": "light thick",
        "w": 24,
        "h": 7,
        "x": 0,
