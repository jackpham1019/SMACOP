    {
      "type": 3,
      "name": "P95 Latency by Service",
      "content": {
        "version": "KqlItem/1.0",
        "title": "P95 Latency by Service ({TimeRange})",
        "query": "AppRequests\n| where TimeGenerated {TimeRange}\n| extend\n    Service = iff(\n        isnotempty(AppRoleName),\n        AppRoleName,\n        \"unknown\"\n    )\n| summarize\n    P95Latency = percentilew(\n        DurationMs,\n        ItemCount,\n        95\n    )\n    by\n        bin(TimeGenerated, 5m),\n        Service\n| project\n    TimeGenerated,\n    Service,\n    P95Latency\n| order by TimeGenerated asc",
